# Clerk development instance (also read by FastAPI to verify signed bridge calls)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase: PostgreSQL + pgvector. Service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic API for answers and embeddings (required)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# FastAPI origin used by the Next.js server bridge; keep the local default unless deployed separately.
FASTAPI_ORIGIN=http://127.0.0.1:8000



